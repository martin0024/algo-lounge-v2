    {"input":[["same","same","same"],2],"expected":[4,4,4]},
    {"input":[["flower","flow","flight"],2],"expected":[2,2,4]},
    {"input":[["apple","ape","april","banana"],2],"expected":[2,2,2,2]},
    {"input":[["aa","aaa","aaaa","b"],3],"expected":[0,0,0,2]},
    {"input":[["cat","car","cart","dog","dove"],2],"expected":[3,2,2,3,3]},
