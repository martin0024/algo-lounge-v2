{
  "functionName": "isSubtree",
  "args": ["root", "subRoot"],
  "harness": "binary-tree",
  "cases": [
    {"input":[[3,4,5,1,2],[4,1,2]],"expected":true},
    {"input":[[3,4,5,1,2,null,null,null,null,0],[4,1,2]],"expected":false},
    {"input":[[1,2,3],[2]],"expected":true},
    {"input":[[1,2,3],[3]],"expected":true},
    {"input":[[1],[1]],"expected":true},
    {"input":[[1,2],[1]],"expected":false},
    {"input":[[1,null,2,null,3],[2,null,3]],"expected":true},
    {"input":[[1,2,3,4,5,6,7],[3,6,7]],"expected":true},
    {"input":[[1,2,3,4,5,6,7],[3,6,8]],"expected":false},
    {"input":[[1,1],[1]],"expected":true}
  ]
}
