{
  "functionName": "isSymmetric",
  "args": ["root"],
  "harness": "binary-tree",
  "cases": [
    {"input":[[1,2,2,3,4,4,3]],"expected":true},
    {"input":[[1,2,2,null,3,null,3]],"expected":false},
    {"input":[[1]],"expected":true},
    {"input":[[1,2,2,2,null,2]],"expected":false},
    {"input":[[1,2,2,null,null,null,null]],"expected":true},
    {"input":[[5,4,4,3,null,null,3]],"expected":true},
    {"input":[[1,0,0,null,-1,-1,null]],"expected":true},
    {"input":[[2,3,3,4,5,5,4]],"expected":true}
  ]
}
